{
  "info": {
    "name": "Agenda IA - Pruebas",
    "description": "Pruebas del flujo Postman -> n8n -> IA -> Backend",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "webhook_url", "value": "http://localhost:5678/webhook/chat-agenda" },
    { "key": "backend_url", "value": "http://localhost:3000" }
  ],
  "item": [
    {
      "name": "n8n - Flujo del agente",
      "item": [
        {
          "name": "1. Saludo inicial",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"canal\": \"postman\",\n  \"usuario_id\": \"111\",\n  \"texto\": \"Hola, buenas!\"\n}"
            },
            "url": "{{webhook_url}}"
          }
        },
        {
          "name": "2. Pregunta por servicios",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"canal\": \"postman\",\n  \"usuario_id\": \"111\",\n  \"texto\": \"Cuanto cuesta una consulta general?\"\n}"
            },
            "url": "{{webhook_url}}"
          }
        },
        {
          "name": "3. Pregunta por otro servicio",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"canal\": \"postman\",\n  \"usuario_id\": \"111\",\n  \"texto\": \"Y una inyeccion cuanto vale?\"\n}"
            },
            "url": "{{webhook_url}}"
          }
        },
        {
          "name": "4. Registrar lead (nombre y telefono)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"canal\": \"postman\",\n  \"usuario_id\": \"111\",\n  \"texto\": \"Me llamo Juan Perez, mi telefono es 0991234567\"\n}"
            },
            "url": "{{webhook_url}}"
          }
        },
        {
          "name": "5. Otro paciente nuevo (usuario_id distinto)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"canal\": \"postman\",\n  \"usuario_id\": \"222\",\n  \"texto\": \"Buenas, quisiera saber los servicios que ofrecen\"\n}"
            },
            "url": "{{webhook_url}}"
          }
        }
      ]
    },
    {
      "name": "Backend directo (debug)",
      "item": [
        {
          "name": "Health check",
          "request": { "method": "GET", "url": "{{backend_url}}/health" }
        },
        {
          "name": "Ver servicios",
          "request": { "method": "GET", "url": "{{backend_url}}/servicios" }
        },
        {
          "name": "Ver leads registrados",
          "request": { "method": "GET", "url": "{{backend_url}}/leads" }
        }
      ]
    }
  ]
}
