generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// =====================================================
// ENUMS
// =====================================================

enum DiaSemana {
  LUNES
  MARTES
  MIERCOLES
  JUEVES
  VIERNES
  SABADO
  DOMINGO
}

enum TipoExcepcionHorario {
  BLOQUEO
  DISPONIBILIDAD_EXTRA
}

enum EstadoCita {
  RESERVA_TEMPORAL
  PENDIENTE_PAGO
  CONFIRMADA
  ATENDIDA
  CANCELADA
  NO_ASISTIO
  EXPIRADA
}

enum MetodoPago {
  TRANSFERENCIA
  EFECTIVO
  PASARELA
}

enum ProveedorPago {
  SIMULADOR
  PAYPHONE
}

enum EstadoPago {
  PENDIENTE
  EXPIRADO
  COMPROBANTE_RECIBIDO
  EN_CONCILIACION
  CONFIRMADO
  RECHAZADO
  REEMBOLSADO
}

enum EstadoProcesamientoComprobante {
  RECIBIDO
  PROCESADO
  ERROR
}

enum OrigenTransaccionBancaria {
  EMAIL
  API
  PASARELA
  MANUAL
}

enum EstadoConciliacion {
  PENDIENTE
  COINCIDENCIA_AUTOMATICA
  REVISION_MANUAL
  APROBADA_MANUALMENTE
  RECHAZADA
}

// =====================================================
// ORGANIZACIONES
// =====================================================

model Organizacion {
  id              Int     @id @default(autoincrement())
  codigo          String  @unique @db.VarChar(50)
  nombre          String  @db.VarChar(150)
  nombreComercial String? @map("nombre_comercial") @db.VarChar(150)

  telefono String? @db.VarChar(30)
  email    String? @db.VarChar(150)

  ruc         String? @unique @db.VarChar(13)
  descripcion String? @db.VarChar(500)
  logoUrl     String? @map("logo_url") @db.VarChar(500)

  pais      String   @default("EC") @db.VarChar(2)
  provincia String?  @db.VarChar(100)
  ciudad    String?  @db.VarChar(100)
  direccion String?  @db.VarChar(300)
  latitud   Decimal? @db.Decimal(9, 6)
  longitud  Decimal? @db.Decimal(9, 6)

  moneda String @default("USD") @db.VarChar(3)

  verificada Boolean @default(false)

  // Politica de servicios de la empresa
  // false = todos cobran el precio del servicio; true = cada profesional puede fijar el suyo
  preciosPorProfesional       Boolean @default(false) @map("precios_por_profesional")
  // true = un profesional puede crear servicios propios (solo los ofrece el)
  profesionalesCreanServicios Boolean @default(true) @map("profesionales_crean_servicios")
  // false = todo se paga a las cuentas de la empresa; true = cada profesional cobra en las suyas
  // (si no registro ninguna, se usan las de la empresa)
  cobroPorProfesional         Boolean @default(false) @map("cobro_por_profesional")

  // persona que representa legalmente a la empresa
  representanteId Int? @map("representante_id")

  // tipo de negocio (subcategoria: Salud > Odontologia). Define que se reserva y los cargos del personal.
  // null en empresas registradas antes de existir las categorias.
  categoriaId Int? @map("categoria_id")

  zonaHoraria String @default("America/Guayaquil") @map("zona_horaria") @db.VarChar(80)

  activo Boolean @default(true)

  fechaCreacion      DateTime @default(now()) @map("fecha_creacion") @db.Timestamptz(6)
  fechaActualizacion DateTime @updatedAt @map("fecha_actualizacion") @db.Timestamptz(6)

  profesionales          Profesional[]
  clientes               Cliente[]
  servicios              Servicio[]
  citas                  Cita[]
  pagos                  Pago[]
  transaccionesBancarias TransaccionBancaria[]
  canalesAtencion        CanalAtencion[]
  usuarios               Usuario[]
  rols                   Rol[]
  modulos                OrganizacionModulo[]
  suscripciones          Suscripcion[]
  documentos             Documento[]
  mediosCobro            MedioCobro[]

  representante Persona?          @relation(fields: [representanteId], references: [id])
  categoria     CategoriaEmpresa? @relation(fields: [categoriaId], references: [id])

  @@index([categoriaId])
  @@map("organizaciones")
}

// =====================================================
// PROFESIONALES
// =====================================================

model Profesional {
  id             Int @id @default(autoincrement())
  organizacionId Int @map("organizacion_id")

  codigo String @db.VarChar(50)

  nombre   String  @db.VarChar(100)
  apellido String? @db.VarChar(100)

  telefono String? @db.VarChar(30)
  email    String? @db.VarChar(150)

  tipoProfesional String? @map("tipo_profesional") @db.VarChar(100)
  descripcion     String? @db.Text

  zonaHoraria String? @map("zona_horaria") @db.VarChar(80)

  intervaloAgendaMinutos Int @default(30) @map("intervalo_agenda_minutos")

  activo Boolean @default(true)

  fechaCreacion      DateTime @default(now()) @map("fecha_creacion") @db.Timestamptz(6)
  fechaActualizacion DateTime @updatedAt @map("fecha_actualizacion") @db.Timestamptz(6)

  organizacion Organizacion @relation(fields: [organizacionId], references: [id])

  servicios       ProfesionalServicio[]
  horarios        HorarioProfesional[]
  excepciones     ExcepcionHorario[]
  citas           Cita[]
  canalesAtencion CanalAtencion[]
  usuarios        Usuario[]
  mediosCobro     MedioCobro[]

  @@unique([organizacionId, codigo])
  @@index([organizacionId])
  @@map("profesionales")
}

// =====================================================
// CLIENTES
// =====================================================

model Cliente {
  id             Int @id @default(autoincrement())
  organizacionId Int @map("organizacion_id")

  nombre   String  @db.VarChar(100)
  apellido String? @db.VarChar(100)

  telefono  String  @db.VarChar(30)
  email     String? @db.VarChar(150)
  direccion String? @db.VarChar(300)

  activo Boolean @default(true)

  fechaCreacion      DateTime @default(now()) @map("fecha_creacion") @db.Timestamptz(6)
  fechaActualizacion DateTime @updatedAt @map("fecha_actualizacion") @db.Timestamptz(6)

  organizacion Organizacion @relation(fields: [organizacionId], references: [id])

  citas Cita[]

  @@unique([organizacionId, telefono])
  @@index([organizacionId])
  @@map("clientes")
}

// =====================================================
// SERVICIOS
// =====================================================

model Servicio {
  id             Int @id @default(autoincrement())
  organizacionId Int @map("organizacion_id")

  codigo String @db.VarChar(80)

  nombre      String  @db.VarChar(150)
  descripcion String? @db.Text

  precio          Decimal @db.Decimal(10, 2)
  duracionMinutos Int     @map("duracion_minutos")

  requierePagoPrevio Boolean  @default(false) @map("requiere_pago_previo")
  porcentajeAnticipo Decimal? @map("porcentaje_anticipo") @db.Decimal(5, 2)

  activo Boolean @default(true)

  fechaCreacion      DateTime @default(now()) @map("fecha_creacion") @db.Timestamptz(6)
  fechaActualizacion DateTime @updatedAt @map("fecha_actualizacion") @db.Timestamptz(6)

  organizacion Organizacion @relation(fields: [organizacionId], references: [id])

  profesionales ProfesionalServicio[]
  citas         Cita[]

  @@unique([organizacionId, codigo])
  @@index([organizacionId])
  @@map("servicios")
}

// =====================================================
// PROFESIONALES <-> SERVICIOS
// =====================================================

model ProfesionalServicio {
  id Int @id @default(autoincrement())

  profesionalId Int @map("profesional_id")
  servicioId    Int @map("servicio_id")

  precioPersonalizado          Decimal? @map("precio_personalizado") @db.Decimal(10, 2)
  duracionPersonalizadaMinutos Int?     @map("duracion_personalizada_minutos")

  activo Boolean @default(true)

  profesional Profesional @relation(fields: [profesionalId], references: [id])
  servicio    Servicio    @relation(fields: [servicioId], references: [id])

  @@unique([profesionalId, servicioId])
  @@index([servicioId])
  @@map("profesionales_servicios")
}

// =====================================================
// HORARIO RECURRENTE DEL PROFESIONAL
// =====================================================

model HorarioProfesional {
  id Int @id @default(autoincrement())

  profesionalId Int @map("profesional_id")

  diaSemana DiaSemana @map("dia_semana")

  horaInicio DateTime @map("hora_inicio") @db.Time(0)
  horaFin    DateTime @map("hora_fin") @db.Time(0)

  activo Boolean @default(true)

  profesional Profesional @relation(fields: [profesionalId], references: [id])

  @@unique([profesionalId, diaSemana, horaInicio, horaFin])
  @@index([profesionalId, diaSemana])
  @@map("horarios_profesional")
}

// =====================================================
// EXCEPCIONES
// =====================================================

model ExcepcionHorario {
  id Int @id @default(autoincrement())

  profesionalId Int @map("profesional_id")

  fecha DateTime @db.Date

  horaInicio DateTime? @map("hora_inicio") @db.Time(0)
  horaFin    DateTime? @map("hora_fin") @db.Time(0)

  diaCompleto Boolean @default(false) @map("dia_completo")

  tipo TipoExcepcionHorario

  motivo String? @db.VarChar(250)

  profesional Profesional @relation(fields: [profesionalId], references: [id])

  @@index([profesionalId, fecha])
  @@map("excepciones_horario")
}

// =====================================================
// CITAS
// =====================================================

model Cita {
  id Int @id @default(autoincrement())

  organizacionId Int @map("organizacion_id")
  profesionalId  Int @map("profesional_id")
  clienteId      Int @map("cliente_id")
  servicioId     Int @map("servicio_id")

  fechaInicio DateTime @map("fecha_inicio") @db.Timestamptz(6)
  fechaFin    DateTime @map("fecha_fin") @db.Timestamptz(6)

  precio Decimal @db.Decimal(10, 2)

  duracionMinutos Int @map("duracion_minutos")

  estado EstadoCita @default(RESERVA_TEMPORAL)

  fechaExpiracionReserva DateTime? @map("fecha_expiracion_reserva") @db.Timestamptz(6)

  notasCliente String? @map("notas_cliente") @db.Text

  fechaCreacion      DateTime @default(now()) @map("fecha_creacion") @db.Timestamptz(6)
  fechaActualizacion DateTime @updatedAt @map("fecha_actualizacion") @db.Timestamptz(6)

  organizacion Organizacion @relation(fields: [organizacionId], references: [id])
  profesional  Profesional  @relation(fields: [profesionalId], references: [id])
  cliente      Cliente      @relation(fields: [clienteId], references: [id])
  servicio     Servicio     @relation(fields: [servicioId], references: [id])

  pagos Pago[]

  @@index([profesionalId, fechaInicio, fechaFin])
  @@index([clienteId, fechaInicio])
  @@index([estado])
  @@index([fechaExpiracionReserva])
  @@map("citas")
}

// =====================================================
// PAGOS
// =====================================================

model Pago {
  id Int @id @default(autoincrement())

  organizacionId Int @map("organizacion_id")
  citaId         Int @map("cita_id")

  montoEsperado Decimal  @map("monto_esperado") @db.Decimal(10, 2)
  montoRecibido Decimal? @map("monto_recibido") @db.Decimal(10, 2)

  metodo MetodoPago
  estado EstadoPago @default(PENDIENTE)

  referenciaCobro            String        @unique @map("referencia_cobro") @db.VarChar(80)
  proveedor                  ProveedorPago @default(SIMULADOR)
  referenciaProveedor        String?       @unique @map("referencia_proveedor") @db.VarChar(150)
  urlPago                    String?       @map("url_pago") @db.VarChar(500)
  moneda                     String        @default("USD") @db.Char(3)
  porcentajeAnticipoAplicado Decimal?      @map("porcentaje_anticipo_aplicado") @db.Decimal(5, 2)
  fechaExpiracion            DateTime?     @map("fecha_expiracion") @db.Timestamptz(6)

  referenciaBancaria String? @map("referencia_bancaria") @db.VarChar(150)

  fechaPago         DateTime? @map("fecha_pago") @db.Timestamptz(6)
  fechaConfirmacion DateTime? @map("fecha_confirmacion") @db.Timestamptz(6)

  fechaCreacion      DateTime @default(now()) @map("fecha_creacion") @db.Timestamptz(6)
  fechaActualizacion DateTime @updatedAt @map("fecha_actualizacion") @db.Timestamptz(6)

  organizacion Organizacion @relation(fields: [organizacionId], references: [id])
  cita         Cita         @relation(fields: [citaId], references: [id])

  comprobantes   ComprobantePago[]
  conciliaciones ConciliacionPago[]

  @@index([citaId])
  @@index([estado])
  @@map("pagos")
}

// =====================================================
// COMPROBANTES DE PAGO
// =====================================================

model ComprobantePago {
  id Int @id @default(autoincrement())

  pagoId Int @map("pago_id")

  archivoUrl  String  @map("archivo_url") @db.VarChar(500)
  hashArchivo String? @unique @map("hash_archivo") @db.VarChar(150)
  // archivo subido (PDF o imagen) guardado en el almacenamiento de documentos
  documentoId Int?    @map("documento_id")

  montoDetectado      Decimal?  @map("monto_detectado") @db.Decimal(10, 2)
  fechaDetectada      DateTime? @map("fecha_detectada") @db.Timestamptz(6)
  referenciaDetectada String?   @map("referencia_detectada") @db.VarChar(150)
  bancoDetectado      String?   @map("banco_detectado") @db.VarChar(150)
  nombreDetectado     String?   @map("nombre_detectado") @db.VarChar(200)

  estadoProcesamiento EstadoProcesamientoComprobante @default(RECIBIDO) @map("estado_procesamiento")

  fechaCreacion DateTime @default(now()) @map("fecha_creacion") @db.Timestamptz(6)

  pago      Pago       @relation(fields: [pagoId], references: [id])
  documento Documento? @relation(fields: [documentoId], references: [id])

  @@index([pagoId])
  @@map("comprobantes_pago")
}

// =====================================================
// MOVIMIENTOS BANCARIOS RECIBIDOS
// =====================================================

model TransaccionBancaria {
  id Int @id @default(autoincrement())

  organizacionId Int @map("organizacion_id")

  banco         String  @db.VarChar(150)
  cuentaDestino String? @map("cuenta_destino") @db.VarChar(100)

  referencia String? @db.VarChar(150)
  monto      Decimal @db.Decimal(10, 2)

  ordenante String? @db.VarChar(200)

  fechaTransaccion DateTime? @map("fecha_transaccion") @db.Timestamptz(6)
  fechaRecepcion   DateTime  @default(now()) @map("fecha_recepcion") @db.Timestamptz(6)

  origen OrigenTransaccionBancaria

  hashEvento String? @unique @map("hash_evento") @db.VarChar(150)

  payloadRaw Json? @map("payload_raw")

  organizacion Organizacion @relation(fields: [organizacionId], references: [id])

  conciliaciones ConciliacionPago[]

  @@index([organizacionId, fechaTransaccion])
  @@index([referencia])
  @@map("transacciones_bancarias")
}

// =====================================================
// CONCILIACIÓN
// =====================================================

model ConciliacionPago {
  id Int @id @default(autoincrement())

  pagoId                Int @map("pago_id")
  transaccionBancariaId Int @map("transaccion_bancaria_id")

  puntajeCoincidencia Decimal @map("puntaje_coincidencia") @db.Decimal(5, 2)

  coincideMonto      Boolean @default(false) @map("coincide_monto")
  coincideReferencia Boolean @default(false) @map("coincide_referencia")
  coincideFecha      Boolean @default(false) @map("coincide_fecha")
  coincideCuenta     Boolean @default(false) @map("coincide_cuenta")

  estado EstadoConciliacion @default(PENDIENTE)

  observacion String? @db.Text

  fechaCreacion DateTime @default(now()) @map("fecha_creacion") @db.Timestamptz(6)

  pago                Pago                @relation(fields: [pagoId], references: [id])
  transaccionBancaria TransaccionBancaria @relation(fields: [transaccionBancariaId], references: [id])

  @@unique([pagoId, transaccionBancariaId])
  @@index([estado])
  @@map("conciliaciones_pago")
}

// =====================================================
// CANAL ATENCION
// =================================================
model CanalAtencion {
  id Int @id @default(autoincrement())

  organizacionId Int @map("organizacion_id")
  profesionalId  Int @map("profesional_id")

  tipo String @db.VarChar(30)

  // Durante desarrollo:
  // wa-carlos-demo
  // wa-ana-demo
  //
  // Cuando conectemos WhatsApp Cloud:
  // aquí podremos guardar el phone_number_id de Meta.
  identificador String @unique @db.VarChar(150)

  numeroDestino String? @map("numero_destino") @db.VarChar(30)

  activo Boolean @default(true)

  fechaCreacion DateTime @default(now()) @map("fecha_creacion") @db.Timestamptz(6)

  organizacion Organizacion @relation(fields: [organizacionId], references: [id])

  profesional Profesional @relation(fields: [profesionalId], references: [id])

  @@index([organizacionId, activo])
  @@index([profesionalId, activo])
  @@map("canales_atencion")
}

// =====================================================
// ACCESO: USUARIOS, ROLES, PERMISOS Y TOKENS
// =====================================================

enum TipoAcceso {
  SUPER_ADMIN
  ADMIN_EMPRESA
  PERSONAL
  CLIENTE
}

enum AlcanceRol {
  ORGANIZACION
  PROPIO
}

enum TipoIdentificacion {
  CEDULA
  PASAPORTE
}

// Toda persona del sistema: representante de una empresa, usuario, y mas adelante clientes y profesionales.
model Persona {
  id Int @id @default(autoincrement())

  // opcionales: un lead de WhatsApp puede traer solo el telefono
  tipoIdentificacion TipoIdentificacion? @map("tipo_identificacion")
  identificacion     String?             @db.VarChar(20)

  nombres   String  @db.VarChar(100)
  apellidos String? @db.VarChar(100)

  telefono        String?   @db.VarChar(30)
  email           String?   @db.VarChar(150)
  direccion       String?   @db.VarChar(300)
  fechaNacimiento DateTime? @map("fecha_nacimiento") @db.Date

  fechaCreacion      DateTime @default(now()) @map("fecha_creacion") @db.Timestamptz(6)
  fechaActualizacion DateTime @updatedAt @map("fecha_actualizacion") @db.Timestamptz(6)

  usuario        Usuario?
  organizaciones Organizacion[]

  @@unique([tipoIdentificacion, identificacion])
  @@map("personas")
}

model Usuario {
  id Int @id @default(autoincrement())

  personaId Int @unique @map("persona_id")

  email String @unique @db.VarChar(150)

  // null cuando la identidad vive en Keycloak
  passwordHash String? @map("password_hash") @db.VarChar(255)
  // identificador del usuario en Keycloak (campo "sub"), para integrarlo despues
  idExterno    String? @unique @map("id_externo") @db.VarChar(100)

  tipoAcceso TipoAcceso @map("tipo_acceso")

  organizacionId Int? @map("organizacion_id")
  rolId          Int? @map("rol_id")
  profesionalId  Int? @map("profesional_id")
  creadoPorId    Int? @map("creado_por_id")

  // que hace la persona en la empresa (Odontologo, Recepcionista, Mesero) y una nota libre
  cargoId          Int?    @map("cargo_id")
  cargoObservacion String? @map("cargo_observacion") @db.VarChar(250)

  activo          Boolean @default(true)
  esClaveTemporal Boolean @default(false) @map("es_clave_temporal")

  intentosFallidos Int       @default(0) @map("intentos_fallidos")
  bloqueadoHasta   DateTime? @map("bloqueado_hasta") @db.Timestamptz(6)
  ultimoLogin      DateTime? @map("ultimo_login") @db.Timestamptz(6)

  fechaCreacion      DateTime @default(now()) @map("fecha_creacion") @db.Timestamptz(6)
  fechaActualizacion DateTime @updatedAt @map("fecha_actualizacion") @db.Timestamptz(6)

  persona       Persona        @relation(fields: [personaId], references: [id])
  organizacion  Organizacion?  @relation(fields: [organizacionId], references: [id])
  rol           Rol?           @relation(fields: [rolId], references: [id])
  profesional   Profesional?   @relation(fields: [profesionalId], references: [id])
  cargo         Cargo?         @relation(fields: [cargoId], references: [id])
  refreshTokens RefreshToken[]
  documentos    Documento[]

  @@index([organizacionId])
  @@map("usuarios")
}

model Permiso {
  id Int @id @default(autoincrement())

  codigo      String  @unique @db.VarChar(80)
  categoria   String? @db.VarChar(50)
  descripcion String? @db.VarChar(250)

  // pantalla a la que pertenece este boton o accion
  pantallaId Int? @map("pantalla_id")

  // accion del catalogo que representa este boton (Ver, Crear, Editar...).
  // null en los permisos que no son un boton de pantalla (ej. citas.gestionar).
  accionId Int? @map("accion_id")

  pantalla Pantalla?    @relation(fields: [pantallaId], references: [id])
  accion   Accion?      @relation(fields: [accionId], references: [id])
  roles    RolPermiso[]

  // una pantalla no puede tener dos veces la misma accion
  @@unique([pantallaId, accionId])
  @@map("permisos")
}

// Catalogo de botones que se pueden poner en una pantalla (Ver, Crear, Editar, Eliminar...).
// Al asignar una accion a una pantalla se crea su permiso: <recurso>.<accion>, ej. historia_clinica.ver
model Accion {
  id Int @id @default(autoincrement())

  codigo String  @unique @db.VarChar(40)
  nombre String  @db.VarChar(60)
  icono  String? @db.VarChar(60)
  orden  Int     @default(0)
  activo Boolean @default(true)

  // false = el boton funciona sin un registro seleccionado (Crear, Exportar)
  requiereSeleccion Boolean @default(true) @map("requiere_seleccion")

  permisos Permiso[]

  @@map("acciones")
}

model Rol {
  id Int @id @default(autoincrement())

  // null = rol plantilla del sistema
  organizacionId Int? @map("organizacion_id")

  codigo      String  @db.VarChar(60)
  nombre      String  @db.VarChar(100)
  descripcion String? @db.VarChar(250)

  alcance   AlcanceRol @default(ORGANIZACION)
  esSistema Boolean    @default(false) @map("es_sistema")
  activo    Boolean    @default(true)

  fechaCreacion DateTime @default(now()) @map("fecha_creacion") @db.Timestamptz(6)

  organizacion Organizacion? @relation(fields: [organizacionId], references: [id])

  permisos  RolPermiso[]
  usuarios  Usuario[]
  pantallas RolPantalla[]

  @@unique([organizacionId, codigo])
  @@index([organizacionId])
  @@map("roles")
}

model RolPermiso {
  rolId     Int @map("rol_id")
  permisoId Int @map("permiso_id")

  rol     Rol     @relation(fields: [rolId], references: [id], onDelete: Cascade)
  permiso Permiso @relation(fields: [permisoId], references: [id])

  @@id([rolId, permisoId])
  @@map("roles_permisos")
}

model RefreshToken {
  id Int @id @default(autoincrement())

  usuarioId Int @map("usuario_id")

  tokenHash String @unique @map("token_hash") @db.VarChar(128)
  familiaId String @map("familia_id") @db.VarChar(64)

  expiraEn         DateTime  @map("expira_en") @db.Timestamptz(6)
  revocadoEn       DateTime? @map("revocado_en") @db.Timestamptz(6)
  reemplazadoPorId Int?      @map("reemplazado_por_id")

  ip        String? @db.VarChar(64)
  userAgent String? @map("user_agent") @db.VarChar(300)

  fechaCreacion DateTime @default(now()) @map("fecha_creacion") @db.Timestamptz(6)

  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@index([usuarioId])
  @@index([familiaId])
  @@map("refresh_tokens")
}

// =====================================================
// MODULOS Y PANTALLAS (catalogo de la plataforma, lo administra el super admin)
// =====================================================

model Modulo {
  id Int @id @default(autoincrement())

  codigo      String  @unique @db.VarChar(60)
  nombre      String  @db.VarChar(100)
  descripcion String? @db.VarChar(250)
  icono       String? @db.VarChar(60)
  orden       Int     @default(0)

  // true = lo tienen todas las empresas sin licencia (Inicio, Configuracion)
  esBase Boolean @default(false) @map("es_base")
  activo Boolean @default(true)

  // Precio de venta del modulo suelto (fuera de un plan). null = no se vende suelto.
  precio       Decimal?     @db.Decimal(10, 2)
  moneda       String       @default("USD") @db.VarChar(3)
  periodicidad Periodicidad @default(MENSUAL)

  pantallas      Pantalla[]
  organizaciones OrganizacionModulo[]
  planes         PlanModulo[]

  @@map("modulos")
}

// Cada cuanto se cobra un plan o un modulo suelto.
enum Periodicidad {
  MENSUAL
  ANUAL
}

// =====================================================
// CATEGORIAS DE NEGOCIO Y CARGOS
// =====================================================

// Que reserva el cliente en un tipo de negocio: personas (doctor, barbero),
// espacios (cancha, mesa, sala) o ambos (gimnasio: entrenador y sala).
enum TipoReserva {
  PERSONAS
  ESPACIOS
  AMBOS
}

// Dos niveles: categoria general (padreId null: Salud, Deportes) y subcategoria
// (Salud > Odontologia). La empresa guarda la subcategoria. Los administra el super admin.
model CategoriaEmpresa {
  id      Int  @id @default(autoincrement())
  padreId Int? @map("padre_id")

  codigo      String      @unique @db.VarChar(60)
  nombre      String      @db.VarChar(100)
  descripcion String?     @db.VarChar(250)
  icono       String?     @db.VarChar(60)
  reserva     TipoReserva @default(PERSONAS)
  orden       Int         @default(0)

  activo Boolean @default(true)

  fechaCreacion      DateTime @default(now()) @map("fecha_creacion") @db.Timestamptz(6)
  fechaActualizacion DateTime @updatedAt @map("fecha_actualizacion") @db.Timestamptz(6)

  padre          CategoriaEmpresa?  @relation("CategoriaSubcategorias", fields: [padreId], references: [id])
  subcategorias  CategoriaEmpresa[] @relation("CategoriaSubcategorias")
  cargos         Cargo[]
  organizaciones Organizacion[]

  @@index([padreId])
  @@map("categorias_empresa")
}

// Lo que hace una persona en la empresa. Una subcategoria ve sus cargos y los de su categoria general.
model Cargo {
  id          Int @id @default(autoincrement())
  categoriaId Int @map("categoria_id")

  codigo      String  @unique @db.VarChar(60)
  nombre      String  @db.VarChar(100)
  descripcion String? @db.VarChar(250)
  orden       Int     @default(0)

  activo Boolean @default(true)

  fechaCreacion      DateTime @default(now()) @map("fecha_creacion") @db.Timestamptz(6)
  fechaActualizacion DateTime @updatedAt @map("fecha_actualizacion") @db.Timestamptz(6)

  categoria CategoriaEmpresa @relation(fields: [categoriaId], references: [id])
  usuarios  Usuario[]

  @@index([categoriaId])
  @@map("cargos")
}

// =====================================================
// CATALOGOS GENERICOS
// =====================================================

// Listas de valores de la plataforma (bancos, billeteras, tipos de cuenta, tipos de documento...).
// El codigo del catalogo lo usa el backend; sus items los administra el super admin.
model Catalogo {
  id Int @id @default(autoincrement())

  codigo      String  @unique @db.VarChar(60)
  nombre      String  @db.VarChar(100)
  descripcion String? @db.VarChar(250)

  activo Boolean @default(true)

  fechaCreacion      DateTime @default(now()) @map("fecha_creacion") @db.Timestamptz(6)
  fechaActualizacion DateTime @updatedAt @map("fecha_actualizacion") @db.Timestamptz(6)

  items CatalogoItem[]

  @@map("catalogos")
}

model CatalogoItem {
  id         Int @id @default(autoincrement())
  catalogoId Int @map("catalogo_id")

  codigo      String  @db.VarChar(60)
  nombre      String  @db.VarChar(150)
  descripcion String? @db.VarChar(250)
  orden       Int     @default(0)

  activo Boolean @default(true)

  fechaCreacion      DateTime @default(now()) @map("fecha_creacion") @db.Timestamptz(6)
  fechaActualizacion DateTime @updatedAt @map("fecha_actualizacion") @db.Timestamptz(6)

  catalogo Catalogo @relation(fields: [catalogoId], references: [id])

  documentos       Documento[]  @relation("DocumentoTipo")
  mediosPorEntidad MedioCobro[] @relation("MedioCobroEntidad")
  mediosPorTipoCta MedioCobro[] @relation("MedioCobroTipoCuenta")

  @@unique([catalogoId, codigo])
  @@index([catalogoId])
  @@map("catalogo_items")
}

// =====================================================
// DOCUMENTOS (archivos en el almacenamiento: SeaweedFS)
// =====================================================

// Metadatos de un archivo; el contenido vive en el almacenamiento, en `ruta`.
// organizacionId null = archivo de la plataforma.
model Documento {
  id             Int  @id @default(autoincrement())
  organizacionId Int? @map("organizacion_id")
  // item del catalogo TIPOS_DOCUMENTO (QR de cobro, comprobante de pago...)
  tipoId         Int  @map("tipo_id")

  nombreOriginal String @map("nombre_original") @db.VarChar(255)
  mimeType       String @map("mime_type") @db.VarChar(100)
  tamanoBytes    Int    @map("tamano_bytes")
  ruta           String @unique @db.VarChar(500)
  hash           String @db.VarChar(64)

  subidoPorId Int?    @map("subido_por_id")
  activo      Boolean @default(true)

  fechaCreacion DateTime @default(now()) @map("fecha_creacion") @db.Timestamptz(6)

  organizacion Organizacion? @relation(fields: [organizacionId], references: [id])
  tipo         CatalogoItem  @relation("DocumentoTipo", fields: [tipoId], references: [id])
  subidoPor    Usuario?      @relation(fields: [subidoPorId], references: [id])

  mediosCobro  MedioCobro[]
  comprobantes ComprobantePago[]

  @@index([organizacionId])
  @@index([tipoId])
  @@map("documentos")
}

// =====================================================
// MEDIOS DE COBRO
// =====================================================

enum TipoMedioCobro {
  TRANSFERENCIA
  BILLETERA
}

// Donde se le paga a la empresa (profesionalId null) o a un profesional.
// TRANSFERENCIA: banco + tipo de cuenta + numero. BILLETERA (Deuna...): numero/telefono + QR.
model MedioCobro {
  id             Int  @id @default(autoincrement())
  organizacionId Int  @map("organizacion_id")
  profesionalId  Int? @map("profesional_id")

  tipo         TipoMedioCobro
  // item de BANCOS (transferencia) o de BILLETERAS (billetera)
  entidadId    Int            @map("entidad_id")
  // item de TIPOS_CUENTA; solo en transferencias
  tipoCuentaId Int?           @map("tipo_cuenta_id")

  numero                String  @db.VarChar(40)
  titular               String  @db.VarChar(150)
  identificacionTitular String? @map("identificacion_titular") @db.VarChar(20)
  alias                 String? @db.VarChar(100)

  // imagen del QR (documento tipo QR de cobro)
  qrDocumentoId Int? @map("qr_documento_id")

  orden  Int     @default(0)
  activo Boolean @default(true)

  fechaCreacion      DateTime @default(now()) @map("fecha_creacion") @db.Timestamptz(6)
  fechaActualizacion DateTime @updatedAt @map("fecha_actualizacion") @db.Timestamptz(6)

  organizacion Organizacion  @relation(fields: [organizacionId], references: [id])
  profesional  Profesional?  @relation(fields: [profesionalId], references: [id])
  entidad      CatalogoItem  @relation("MedioCobroEntidad", fields: [entidadId], references: [id])
  tipoCuenta   CatalogoItem? @relation("MedioCobroTipoCuenta", fields: [tipoCuentaId], references: [id])
  qrDocumento  Documento?    @relation(fields: [qrDocumentoId], references: [id])

  @@index([organizacionId, profesionalId])
  @@map("medios_cobro")
}

// Plan de suscripcion (Basico, Medio, Alto...). Cada plan tiene su propia lista de modulos.
model Plan {
  id Int @id @default(autoincrement())

  codigo      String  @unique @db.VarChar(40)
  nombre      String  @db.VarChar(100)
  descripcion String? @db.VarChar(500)

  precio       Decimal      @db.Decimal(10, 2)
  moneda       String       @default("USD") @db.VarChar(3)
  periodicidad Periodicidad @default(MENSUAL)

  orden  Int     @default(0)
  // false = ya no se ofrece; las suscripciones existentes siguen vigentes
  activo Boolean @default(true)

  fechaCreacion DateTime @default(now()) @map("fecha_creacion") @db.Timestamptz(6)

  modulos       PlanModulo[]
  suscripciones Suscripcion[]

  @@map("planes")
}

model PlanModulo {
  planId   Int @map("plan_id")
  moduloId Int @map("modulo_id")

  plan   Plan   @relation(fields: [planId], references: [id], onDelete: Cascade)
  modulo Modulo @relation(fields: [moduloId], references: [id])

  @@id([planId, moduloId])
  @@index([moduloId])
  @@map("planes_modulos")
}

// Ciclo de vida de una suscripcion.
// PENDIENTE_PAGO: creada, esperando la confirmacion de la pasarela (no da acceso todavia).
// VIGENTE: da acceso a los modulos del plan. FINALIZADA: reemplazada por otro plan o cancelada.
enum EstadoSuscripcion {
  PENDIENTE_PAGO
  VIGENTE
  FINALIZADA
}

// Historial de planes de cada empresa. Solo una esta VIGENTE: al cambiar de plan,
// la anterior pasa a FINALIZADA (con fechaFin) y se crea una nueva.
// Precio, moneda y periodicidad se copian del plan al suscribirse (quedan como se cobraron).
model Suscripcion {
  id Int @id @default(autoincrement())

  organizacionId Int @map("organizacion_id")
  planId         Int @map("plan_id")

  precio       Decimal      @db.Decimal(10, 2)
  moneda       String       @db.VarChar(3)
  periodicidad Periodicidad

  estado      EstadoSuscripcion @default(PENDIENTE_PAGO)
  fechaInicio DateTime          @default(now()) @map("fecha_inicio") @db.Timestamptz(6)
  // null = sin vencimiento
  fechaFin    DateTime?         @map("fecha_fin") @db.Timestamptz(6)

  // Datos del cobro. Sin pasarela: SIN_PASARELA y sin referencia.
  proveedorPago  String?   @map("proveedor_pago") @db.VarChar(30)
  referenciaPago String?   @map("referencia_pago") @db.VarChar(120)
  fechaPago      DateTime? @map("fecha_pago") @db.Timestamptz(6)

  fechaCreacion DateTime @default(now()) @map("fecha_creacion") @db.Timestamptz(6)

  organizacion Organizacion @relation(fields: [organizacionId], references: [id])
  plan         Plan         @relation(fields: [planId], references: [id])

  @@index([organizacionId, estado])
  @@map("suscripciones")
}

model Pantalla {
  id Int @id @default(autoincrement())

  moduloId Int @map("modulo_id")

  codigo String  @unique @db.VarChar(80)
  nombre String  @db.VarChar(100)
  // ruta que el front abre al elegir la pantalla
  ruta   String  @db.VarChar(150)
  icono  String? @db.VarChar(60)
  orden  Int     @default(0)
  activo Boolean @default(true)

  // true = solo la ve el super admin (administración de la plataforma), aunque el módulo sea base
  soloPlataforma Boolean @default(false) @map("solo_plataforma")
  // true = la ve todo usuario sin que su rol la tenga asignada (p. ej. Mi perfil)
  paraTodos      Boolean @default(false) @map("para_todos")

  modulo Modulo @relation(fields: [moduloId], references: [id])

  // los permisos de una pantalla son sus botones y acciones
  permisos Permiso[]
  roles    RolPantalla[]

  @@index([moduloId])
  @@map("pantallas")
}

// Licencia: que modulos tiene contratados cada empresa.
model OrganizacionModulo {
  id Int @id @default(autoincrement())

  organizacionId Int @map("organizacion_id")
  moduloId       Int @map("modulo_id")

  activo      Boolean   @default(true)
  fechaInicio DateTime  @default(now()) @map("fecha_inicio") @db.Timestamptz(6)
  fechaFin    DateTime? @map("fecha_fin") @db.Timestamptz(6)

  // Precio acordado al comprar el modulo suelto (copia del precio del modulo en ese momento).
  // null en licencias asignadas sin cobro (ej. las de desarrollo del seed).
  precio       Decimal?      @db.Decimal(10, 2)
  moneda       String?       @db.VarChar(3)
  periodicidad Periodicidad?

  fechaCreacion      DateTime @default(now()) @map("fecha_creacion") @db.Timestamptz(6)
  fechaActualizacion DateTime @updatedAt @map("fecha_actualizacion") @db.Timestamptz(6)

  organizacion Organizacion @relation(fields: [organizacionId], references: [id])
  modulo       Modulo       @relation(fields: [moduloId], references: [id])

  @@unique([organizacionId, moduloId])
  @@index([moduloId])
  @@map("organizaciones_modulos")
}

// Que pantallas ve cada rol (los botones salen de roles_permisos).
model RolPantalla {
  rolId      Int @map("rol_id")
  pantallaId Int @map("pantalla_id")

  rol      Rol      @relation(fields: [rolId], references: [id], onDelete: Cascade)
  pantalla Pantalla @relation(fields: [pantallaId], references: [id])

  @@id([rolId, pantallaId])
  @@map("roles_pantallas")
}
