# PostgreSQL local de backend/docker-compose.yml: puerto del host 5433, usuario/base agendaia.
DATABASE_URL="postgresql://agendaia:agendaia_dev_2026@localhost:5433/agendaia?schema=public"
PORT=3000
NODE_ENV=development
MINUTOS_RESERVA=15
# Transferencia/efectivo: plazo para pagar y luego plazo para que el profesional valide el pago reportado.
HORAS_PAGO_MANUAL=24
HORAS_VALIDACION_PAGO_MANUAL=72
# Solo se usa en desarrollo para probar POST /webhooks/pagos/simulador.
PAGO_SIMULADOR_SECRETO=cambia-este-secreto-local

# Firma de los tokens de sesión (mínimo 32 caracteres en producción).
# Genera uno con: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Seed de acceso (prisma/seed-acceso.js)
SUPERADMIN_EMAIL=
SUPERADMIN_PASSWORD=
# Solo desarrollo: licencia todos los módulos a todas las empresas existentes.
SEED_LICENCIAR_TODO=false

# Correo (claves temporales de usuarios nuevos).
# ninguno = no se envía: la clave se muestra una vez al administrador que crea el usuario.
# smtp    = Mailtrap, Gmail, SES... con los datos SMTP de abajo.
CORREO_PROVEEDOR=ninguno
CORREO_REMITENTE="Agenda IA <no-responder@agenda-ia.local>"
SMTP_HOST=sandbox.smtp.mailtrap.io
SMTP_PORT=2525
SMTP_SEGURO=false
SMTP_USUARIO=
SMTP_CLAVE=
# URL del front, para el enlace "Ingresar" del correo.
APP_URL=http://localhost:3001

# Almacenamiento de documentos (SeaweedFS: docker compose up -d seaweedfs)
SEAWEED_FILER_URL=http://127.0.0.1:8888
# Carpeta raíz dentro del filer
ALMACENAMIENTO_CARPETA=agendaia
# Tamaño máximo de un archivo subido (MB)
DOCUMENTO_MAX_MB=5

# Cédula ecuatoriana: true (por defecto) valida el dígito verificador.
# Solo en desarrollo, false permite cédulas inventadas (se sigue exigiendo 10 dígitos).
VALIDAR_DIGITO_CEDULA=true
# Variables de integraciones externas. Nunca guardar sus valores reales en git.
PAYPHONE_TOKEN=
PAYPHONE_STORE_ID=
# Habilita esas credenciales solo para el canal autorizado del profesional.
PAYPHONE_CANAL_ID=
# Opcional: solo para pruebas con un endpoint distinto.
PAYPHONE_LINKS_URL=https://pay.payphonetodoesposible.com/api/Links

# Google Calendar por profesional. Registra esta URL en Google Cloud como redirect URI.
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=
GOOGLE_CALENDAR_REDIRECT_URI=http://localhost:3000/integraciones/google/callback
# Cifra tokens de Google en la base. Usa un valor aleatorio distinto de producción.
CIFRADO_SECRET=

# WhatsApp Cloud API de Meta. El puerto 3002 publica SOLO el webhook, no las API internas.
# Mantener false hasta completar los secretos y ejecutar prisma migrate deploy/generate.
META_WHATSAPP_ENABLED=false
META_WHATSAPP_WEBHOOK_HOST=127.0.0.1
META_WHATSAPP_WEBHOOK_PORT=3002
META_WHATSAPP_API_VERSION=v25.0
META_WHATSAPP_ACCESS_TOKEN=
# App settings > Basic > App secret (es diferente del access token).
META_WHATSAPP_APP_SECRET=
# Cadena aleatoria de mínimo 32 caracteres, igual al Verify token configurado en Meta.
META_WHATSAPP_VERIFY_TOKEN=
# phone_number_id de Meta -> identificador de canal activo en canales_atencion.
# Ejemplo: {"1398257703369335":"wa-fredy-demo"}; nunca se toma el canal del texto del paciente.
META_WHATSAPP_CHANNEL_MAP={}
META_WHATSAPP_N8N_URL=http://127.0.0.1:5678/webhook/chat-agenda
# Opcional: solo si ese webhook de n8n se protege con la cabecera X-Agenda-Secret.
META_WHATSAPP_N8N_SECRET=
